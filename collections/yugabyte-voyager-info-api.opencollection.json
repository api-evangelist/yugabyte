{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yugabyte Cloud backup-info voyager-info API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
