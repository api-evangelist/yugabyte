            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{host_port}/api/migrations",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "query",
                "description": "uuid of the voyager migration task"
              },
              {
                "name": "migration_phase",
                "value": "",
                "type": "query",
                "description": "specify the migration phase for which details are required"
              }
            ]
          },
          "docs": "Get the list of Voyager migrations"
        },
        {
          "info": {
