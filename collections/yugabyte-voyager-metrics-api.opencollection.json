{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yugabyte Cloud backup-info voyager-metrics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "voyager-metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Voyager data migration metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{host_port}/api/migration_metrics",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "query",
                "description": "uuid of the voyager migration task"
              }
            ]
          },
          "docs": "Get Voyager data migration metrics"
        }
      ]
    }
  ],
  "bundled": true
}