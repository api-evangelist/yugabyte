{
  "opencollection": "1.0.0",
  "info": {
    "name": "Yugabyte Cloud backup-info Xcluster Metrics API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Xcluster Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of all xCluster replication group ids",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{protocol}://{host_port}/api/xcluster_metrics"
          },
          "docs": "Retrieve the list of databases on which restore is run in the YugabyteDB cluster."
        }
      ]
    }
  ],
  "bundled": true
}